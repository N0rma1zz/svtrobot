<!--
OpenArm bimanual scene for GR00T VLA evaluation.
Based on the original scene.xml, with added table and manipulation object.
Wrist cameras are rendered programmatically from link7 body poses.
-->
<mujoco model="openarm_bimanual scene groot">
  <include file="openarm_bimanual_groot.xml"/>

  <option timestep="0.001" integrator="implicitfast"/>

  <statistic center="0 0 0.43" extent=".85" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-10"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table in front of robot -->
    <body name="table" pos="0.45 0 0.3">
      <geom type="box" size="0.3 0.4 0.01" rgba="0.6 0.4 0.2 1"/>
    </body>

    <!-- Simple manipulation object on table -->
    <body name="red_cube" pos="0.32 0 0.32">
      <freejoint name="cube_joint"/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.9 0.2 0.2 1"
        mass="0.05" friction="1 0.5 0.01"/>
    </body>

    <!-- Soda can: cylindrical target, positioned where red cube used to be -->
    <body name="can" pos="0.32 -0.05 0.33">
      <freejoint name="can_joint"/>
      <geom type="cylinder" size="0.033 0.06" rgba="0.85 0.1 0.1 1"
        mass="0.05" friction="1 0.5 0.01"/>
    </body>

    <!-- Open box receptacle: 4 walls + base -->
    <body name="box" pos="0.45 0.18 0.325">
      <!-- base -->
      <geom type="box" size="0.07 0.07 0.005" pos="0 0 -0.05" rgba="0.6 0.45 0.25 1"/>
      <!-- +x wall -->
      <geom type="box" size="0.005 0.07 0.05" pos="0.07 0 0" rgba="0.6 0.45 0.25 1"/>
      <!-- -x wall -->
      <geom type="box" size="0.005 0.07 0.05" pos="-0.07 0 0" rgba="0.6 0.45 0.25 1"/>
      <!-- +y wall -->
      <geom type="box" size="0.07 0.005 0.05" pos="0 0.07 0" rgba="0.6 0.45 0.25 1"/>
      <!-- -y wall -->
      <geom type="box" size="0.07 0.005 0.05" pos="0 -0.07 0" rgba="0.6 0.45 0.25 1"/>
    </body>
  </worldbody>
</mujoco>
